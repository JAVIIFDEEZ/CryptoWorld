# ═══════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno requeridas
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# NUNCA comitas el archivo .env real al repositorio.
# ═══════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────
#
# DJANGO_SECRET_KEY firma los JWT, los enlaces de verificación de email y
# los de recuperación de contraseña: quien la conozca puede emitir
# sesiones de cualquier usuario. Con DJANGO_DEBUG=False el servidor NO
# arranca si falta o tiene menos de 50 caracteres — es deliberado, para
# que un despliegue no pueda quedarse en silencio con una clave de
# ejemplo. Genera la tuya con:
#
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# En desarrollo puedes dejarla vacía: se genera una efímera por arranque.
DJANGO_SECRET_KEY=

# False es el valor por defecto. Ponlo a True SOLO en local: con DEBUG
# activo, cualquier error devuelve la traza completa y la configuración.
DJANGO_DEBUG=True

# Dominios que sirve la aplicación. En producción no se admite '*'.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ── Base de datos PostgreSQL ──────────────────────────────────────
DB_NAME=cryptoworld_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── CORS y CSRF ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173

# Orígenes autorizados a enviar formularios con token CSRF (el admin de
# Django tras un proxy TLS). Si se deja vacío en producción, se usan los
# mismos que CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=

# ── Sesiones y tokens ────────────────────────────────────────────
# Access corto porque viaja al navegador y no es revocable de uno en uno;
# la renovación con el refresh token es transparente para el cliente.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── Límites de peticiones ────────────────────────────────────────
# Complementan el bloqueo por cuenta ante intentos fallidos de login.
THROTTLE_ANON=120/min
THROTTLE_USER=1000/hour
THROTTLE_ANALYSIS=60/min

# ── Retención de datos ───────────────────────────────────────────
# market_data_snapshots crece ~144 filas/día por activo; el registro de
# auditoría contiene IP y user-agent, así que tampoco se guarda de por
# vida. Ambas tablas se podan con tareas periódicas de Celery.
MARKET_SNAPSHOT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# ── Observabilidad ───────────────────────────────────────────────
# Con DEBUG=False los logs salen en JSON por stdout, con el request-id de
# correlación en cada línea.
DJANGO_LOG_LEVEL=INFO
APP_VERSION=1.140.0

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173

# ── Email transaccional ──────────────────────────────────────────
#
# El backend elige automáticamente según las variables definidas:
#   1. SENDGRID_API_KEY definida → SendGrid Web API (recomendado en producción)
#   2. EMAIL_HOST definida       → SMTP clásico (Gmail, Brevo, Mailgun...)
#   3. Ninguna                   → los emails se imprimen en los logs (desarrollo)
#        docker compose logs -f backend
#
# OPCIÓN A — SendGrid (plan gratuito: 100 emails/día):
#   1. Crea una cuenta en https://sendgrid.com
#   2. Settings → API Keys → Create API Key (permiso: Mail Send)
#   3. Settings → Sender Authentication → verifica tu remitente
#   4. Define SENDGRID_API_KEY y DEFAULT_FROM_EMAIL con el remitente verificado
#
SENDGRID_API_KEY=          # SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret para verificar eventos SendGrid (opcional en desarrollo)
SENDGRID_WEBHOOK_SECRET=

# OPCIÓN B — SMTP clásico (si SENDGRID_API_KEY está vacío):
#   Gmail: smtp.gmail.com + contraseña de aplicación (no la contraseña normal,
#          genérala en https://myaccount.google.com/apppasswords)
#   Brevo: smtp-relay.brevo.com (plan gratuito: 300 emails/día)
#
EMAIL_HOST=                # p. ej. smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=           # email de la cuenta SMTP
EMAIL_HOST_PASSWORD=       # contraseña de aplicación / API key SMTP
EMAIL_USE_TLS=True         # puerto 587 (STARTTLS)
EMAIL_USE_SSL=False        # poner True solo con puerto 465

# Remitente de todos los emails (debe estar verificado en SendGrid,
# o coincidir con EMAIL_HOST_USER si usas SMTP)
DEFAULT_FROM_EMAIL=CryptoWorld <tu-email-verificado@gmail.com>

# ── Celery sin worker dedicado ────────────────────────────────────
# En despliegues con un solo servicio (sin worker), poner a True para
# que los emails y tareas .delay() se ejecuten en el propio proceso web.
CELERY_TASK_ALWAYS_EAGER=False
