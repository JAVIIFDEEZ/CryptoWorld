# ═══════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno requeridas
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# NUNCA comitas el archivo .env real al repositorio.
# ═══════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-cambia-esto-en-produccion-con-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ── Base de datos PostgreSQL ──────────────────────────────────────
DB_NAME=cryptoworld_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173

# ── Email transaccional (SendGrid) ───────────────────────────────
#
# Producción con SendGrid API nativa (recomendado):
#   1. Crea una cuenta en https://sendgrid.com (plan gratuito: 100 emails/día)
#   2. Ve a Settings → API Keys → Create API Key (permiso: Mail Send)
#   3. Verifica tu remitente en Settings → Sender Authentication
#   4. Define SENDGRID_API_KEY (Django usará anymail automáticamente)
#
# Desarrollo sin SendGrid: deja SENDGRID_API_KEY vacío y los emails
# se imprimirán en los logs del contenedor backend.
#   docker compose logs -f backend
#
SENDGRID_API_KEY=          # SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=CryptoWorld <tu-email-verificado@gmail.com>   # remitente verificado en SendGrid

# Webhook secret para verificar eventos SendGrid (opcional en desarrollo)
SENDGRID_WEBHOOK_SECRET=
