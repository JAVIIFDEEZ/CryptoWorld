# ═══════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno requeridas
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# NUNCA comitas el archivo .env real al repositorio.
# ═══════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────
#
# En producción (DJANGO_DEBUG=False) el arranque ABORTA si la clave sigue
# siendo la de ejemplo, si mide menos de 32 caracteres o si ALLOWED_HOSTS
# está vacío o contiene '*'. Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=django-insecure-cambia-esto-en-produccion-con-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Nivel y formato de los logs. En producción, `json` deja una línea JSON por
# evento (lo que esperan Loki/Datadog/CloudWatch); `plain` es legible en local.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=plain

# ── Cifrado de credenciales de exchange ───────────────────────────
#
# Clave DEDICADA para cifrar las claves API de los exchanges de los usuarios.
# Se separa de DJANGO_SECRET_KEY a propósito: rotar la clave de firma no debe
# dejar ilegibles las credenciales de todo el mundo.
#
# Lista separada por comas: la PRIMERA cifra, TODAS descifran. Para rotar sin
# downtime, pon la nueva delante y conserva la anterior hasta que todo se haya
# recifrado.  Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Vacío → se deriva de DJANGO_SECRET_KEY (modo compatibilidad, desaconsejado
# en producción).
CREDENTIALS_ENCRYPTION_KEYS=

# ── Base de datos PostgreSQL ──────────────────────────────────────
DB_NAME=cryptoworld_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Alternativa: si DATABASE_URL está definida tiene prioridad sobre lo anterior
# (Railway y Heroku la inyectan solas).
# DATABASE_URL=postgres://usuario:clave@host:5432/cryptoworld_db

# ── Redis (broker de Celery, caché y capa de WebSockets) ──────────
# Se usan tres bases del mismo Redis: /0 Celery, /1 caché, /2 Channels.
REDIS_URL=redis://localhost:6379/0

# ── CORS y CSRF ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173
# Orígenes de confianza para CSRF. Si se deja vacío se derivan de
# CORS_ALLOWED_ORIGINS, que es lo correcto en el caso habitual.
CSRF_TRUSTED_ORIGINS=

# ── Límites de tasa de la API ─────────────────────────────────────
# Techo global por IP (anónimos) y por usuario autenticado.
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
# Órdenes contra el exchange real: el límite más estricto de la API.
THROTTLE_TRADING_ORDER=20/min

# ── HTTPS (solo se aplican con DJANGO_DEBUG=False) ────────────────
# Poner a False únicamente si el TLS lo termina un proxy que ya redirige.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173

# ── Email transaccional ──────────────────────────────────────────
#
# El backend elige automáticamente según las variables definidas:
#   1. SENDGRID_API_KEY definida → SendGrid Web API (recomendado en producción)
#   2. EMAIL_HOST definida       → SMTP clásico (Gmail, Brevo, Mailgun...)
#   3. Ninguna                   → los emails se imprimen en los logs (desarrollo)
#        docker compose logs -f backend
#
# OPCIÓN A — SendGrid (plan gratuito: 100 emails/día):
#   1. Crea una cuenta en https://sendgrid.com
#   2. Settings → API Keys → Create API Key (permiso: Mail Send)
#   3. Settings → Sender Authentication → verifica tu remitente
#   4. Define SENDGRID_API_KEY y DEFAULT_FROM_EMAIL con el remitente verificado
#
SENDGRID_API_KEY=          # SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret para verificar eventos SendGrid (opcional en desarrollo)
SENDGRID_WEBHOOK_SECRET=

# OPCIÓN B — SMTP clásico (si SENDGRID_API_KEY está vacío):
#   Gmail: smtp.gmail.com + contraseña de aplicación (no la contraseña normal,
#          genérala en https://myaccount.google.com/apppasswords)
#   Brevo: smtp-relay.brevo.com (plan gratuito: 300 emails/día)
#
EMAIL_HOST=                # p. ej. smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=           # email de la cuenta SMTP
EMAIL_HOST_PASSWORD=       # contraseña de aplicación / API key SMTP
EMAIL_USE_TLS=True         # puerto 587 (STARTTLS)
EMAIL_USE_SSL=False        # poner True solo con puerto 465

# Remitente de todos los emails (debe estar verificado en SendGrid,
# o coincidir con EMAIL_HOST_USER si usas SMTP)
DEFAULT_FROM_EMAIL=CryptoWorld <tu-email-verificado@gmail.com>

# ── Celery sin worker dedicado ────────────────────────────────────
# En despliegues con un solo servicio (sin worker), poner a True para
# que los emails y tareas .delay() se ejecuten en el propio proceso web.
CELERY_TASK_ALWAYS_EAGER=False
