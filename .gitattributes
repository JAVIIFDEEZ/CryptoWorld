# Normalización de fin de línea y codificación.
#
# El proyecto se desarrolla en Windows y se despliega en contenedores
# Linux. Sin estas reglas, un editor de Windows puede reescribir un
# fichero en CP1252 y provocar los caracteres corruptos (`Ã³`, `â€”`)
# que ya aparecieron una vez en views.py.

# Por defecto: detectar texto y normalizar a LF en el repositorio.
* text=auto eol=lf

# Scripts y configuración que el contenedor ejecuta: LF obligatorio.
*.sh    text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf

# Código fuente y documentación.
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Binarios: nunca tocar.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff2 binary
*.pdf   binary
